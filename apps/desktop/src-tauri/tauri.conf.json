{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PixelFlow",
  "version": "3.0.0-beta.1",
  "identifier": "com.pixelflow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run worker:build && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173"
    },
    "windows": [
      {
        "title": "PixelFlow",
        "width": 1120,
        "height": 848,
        "minWidth": 900,
        "minHeight": 768,
        "resizable": true,
        "backgroundColor": "#f5f7fa"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "resources": {
      "../../../worker/dist-ondir/pixelflow-worker": "pixelflow-worker"
    }
  }
}
