{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PixelFlow Worker Message",
  "type": "object",
  "required": ["protocol", "request_id", "type", "payload"],
  "properties": {
    "protocol": {"type": "integer", "const": 1},
    "request_id": {"type": "string", "minLength": 1},
    "type": {
      "type": "string",
      "enum": [
        "ping",
        "probe_models",
        "classify_materials",
        "start_generation",
        "cancel_generation",
        "retry_failed",
        "clear_cache",
        "shutdown",
        "ready",
        "status",
        "progress",
        "preview_ready",
        "done",
        "cancelled",
        "error"
      ]
    },
    "payload": {"type": "object"}
  },
  "additionalProperties": false
}
